# Template for your own .env file. Never commit a .env that holds real keys.
#
#   1. Copy this file and name the copy .env  (cp .env.example .env)
#   2. Fill in your own values. .env is listed in .gitignore, so it stays on your computer.
#
# The ytchat command does NOT need this file. Add your key inside the app with
# /add-api-key, or set GROQ_API_KEY / ANTHROPIC_API_KEY as environment variables
# in your shell. ytchat reads them from the environment; it does not load .env.
#
# This file is read by the pipeline in src/logic/ (see src/logic/settings.py).

# Required: your Groq API key. Create one for free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: uncomment a line to override the default in src/logic/settings.py.
# MODEL=openai/gpt-oss-120b
# TEMPERATURE=0.3
# MAX_TOKENS=
# REASONING_EFFORT=medium
# ADDITIONAL_PROMPT=Keep every answer under 100 words.
